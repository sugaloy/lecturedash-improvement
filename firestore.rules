rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all denies access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Lecturers collection
    match /lecturers/{lecturerId} {
      allow read, write: if true;
    }

    // Logs collection
    match /logs/{logId} {
      allow read, write: if true;
    }

    // System collection
    match /system/{configId} {
      allow read, write: if true;
    }
  }
}
